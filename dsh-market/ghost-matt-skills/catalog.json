{
  "skills": [
    {
      "name": "ask-matt",
      "description": "询问当前情形适合哪个 skill 或工作流。作为本插件 skills 的路由入口。仅在用户明确调用时使用。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "code-review",
      "description": "从固定点（commit、branch、tag 或 merge-base）开始，沿 Standards（代码是否遵循仓库记录的编码标准）与 Spec（代码是否符合来源 issue/规格）两个轴审查变更。两个审查由并行子代理执行并并排报告。适用于用户要审查分支、PR、进行中的变更，或要求“review since X”时。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "codebase-design",
      "description": "用于设计深模块的共享词汇。适用于用户想设计或改进模块接口、寻找深化机会、决定接缝位置、提高可测试性或 AI 可导航性，或其他 skill 需要深模块词汇时。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "diagnosing-bugs",
      "description": "面向棘手缺陷和性能回退的诊断循环。适用于用户要求 diagnose/debug，或报告某些内容损坏、抛错、失败或变慢时。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "domain-modeling",
      "description": "构建并打磨项目领域模型。适用于讨论代码库术语、编写或编辑 `GLOSSARY.md`，或记录或编辑 ADR 时。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "grill-me",
      "description": "通过持续追问打磨计划或设计。仅在用户明确调用时使用。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "grill-with-docs",
      "description": "通过持续追问打磨计划或设计，并在过程中同步创建 ADR 和术语表。仅在用户明确调用时使用。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "grilling",
      "description": "围绕计划、决策或想法持续追问用户。适用于用户想对自己的思路做压力测试，或使用任何 “grill” 触发措辞时。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "handoff",
      "description": "将当前对话压缩为交接文档，供另一个代理继续处理。仅在用户明确调用时使用。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "implement",
      "description": "根据规格或一组工单实施工作。仅在用户明确调用时使用。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "implement-spec",
      "description": "在代码中实施 $to-spec 和 $to-tickets 的产出。仅在用户明确调用时使用。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "improve-codebase-architecture",
      "description": "扫描代码库中的模块深化机会，以可视化 HTML 报告呈现，并针对用户选中的候选项深入追问。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "pr",
      "description": "编写 PR 正文时使用。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "prototype",
      "description": "构建一次性原型来回答设计问题。适用于用户想验证状态模型或逻辑是否合理，或探索 UI 应该呈现什么样子时。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "research",
      "description": "对照高可信一手来源调研问题，并将发现保存为仓库中的 Markdown 文件。适用于用户希望调研某个主题、收集文档或 API 事实，或把资料阅读工作委托给后台代理时。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "retro",
      "description": "回顾一次编码会话。仅在用户明确调用时使用。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "setup-matt-pocock-skills",
      "description": "为当前仓库配置工程类 skills，包括 issue 跟踪器、分类标签词汇和领域文档布局。在首次使用其他工程类 skill 前运行一次。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "tdd",
      "description": "测试驱动开发。适用于用户希望先写测试再构建功能或修复缺陷、提到“红—绿—重构”，或需要集成测试时。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "teach",
      "description": "在当前工作区内，通过多次会话教授用户一项新技能或概念。仅在用户明确调用时使用。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "to-questionnaire",
      "description": "把自己无法完整回答的决策整理成问卷，交给掌握相关知识的人填写。仅在用户明确调用时使用。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "to-spec",
      "description": "将当前对话整理成规格并发布到项目 issue 跟踪器；不再访谈，只综合已经讨论过的内容。仅在用户明确调用时使用。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "to-tickets",
      "description": "把计划、规格或当前对话拆成一组曳光弹式垂直切片工单，为每张工单声明阻塞关系，并发布到已配置的 tracker；本地以每张工单一个文件记录，真实 tracker 使用原生阻塞链接。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "triage",
      "description": "通过分诊角色状态机推进 issue 与外部 PR：分类、验证、必要时深入追问，并编写可直接交给代理的简报。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "wait-what",
      "description": "停下来重新解释上一条未能让用户理解的消息。仅在用户明确调用时使用。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "wayfinder",
      "description": "把单次代理会话容纳不下的大型工作规划为 issue tracker 上共享的决策工单地图，并逐项解决，直到通往目标的路径清晰。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "wizard",
      "description": "生成人机交互式 Bash 向导，引导用户完成只有人类能够执行的步骤。适用于配置基础设施、设置凭据或 CI secret、操作陌生的第三方控制台，或执行一次性迁移与切换。代理能够自行执行的步骤不要使用此 skill。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "writing-for-agents",
      "description": "为代理编写文档。适用于创建或编辑 skill，或修改 AGENTS.md、CLAUDE.md 时。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    }
