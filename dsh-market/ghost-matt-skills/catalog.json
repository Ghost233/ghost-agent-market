{
  "skills": [
    {
      "name": "ask-matt",
      "description": "询问当前情形适合哪个 skill 或工作流。作为本插件 skills 的路由入口。仅在用户明确调用时使用。",
      "invocation": {
        "modelInvocable": false,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "code-review",
      "description": "从固定点（commit、branch、tag 或 merge-base）开始，沿 Standards（代码是否遵循仓库记录的编码标准）与 Spec（代码是否符合来源 issue/规格）两个轴审查变更。两个审查由并行子代理执行并并排报告。适用于用户要审查分支、PR、进行中的变更，或要求“review since X”时。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "codebase-design",
      "description": "用于设计深模块的共享词汇。适用于用户想设计或改进模块接口、寻找深化机会、决定接缝位置、提高可测试性或 AI 可导航性，或其他 skill 需要深模块词汇时。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "diagnosing-bugs",
      "description": "面向棘手缺陷和性能回退的诊断循环。适用于用户要求 diagnose/debug，或报告某些内容损坏、抛错、失败或变慢时。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "domain-modeling",
      "description": "构建并打磨项目领域模型。适用于讨论代码库术语、编写或编辑 `GLOSSARY.md`，或记录或编辑 ADR 时。",
      "invocation": {
        "modelInvocable": true,
        "userInvocable": true
      },
      "group": "mattpocock-skills-zh"
    },
    {
      "name": "grill-me",
